# Base URL of the FlashX backend (Spring Boot / NestJS).
#
# Server-side only — no NEXT_PUBLIC_ prefix, so it is never bundled into the
# browser. Only Server Actions talk to the backend.
#
# While this is unset, the auth screens still render and validate, but sign in,
# registration, and the Google button report that the backend is unavailable.
API_BASE_URL=http://localhost:8080
