# Base URL of the FlashX backend (Spring Boot / NestJS).
#
# Server-side only — no NEXT_PUBLIC_ prefix, so it is never bundled into the
# browser. Only Server Actions talk to the backend.
#
# While this is unset, the auth screens still render and validate, but sign in,
# registration, and the Google button report that the backend is unavailable.
API_BASE_URL=http://localhost:8080

# Where the BROWSER is sent to start Google sign-in.
#
# Optional, and only needed when the gateway is reachable at a different address
# from inside this container than from the user's machine — which is exactly the
# docker compose case, where API_BASE_URL is http://api-gateway:8080 and that
# name does not resolve in a browser. Starting Google sign-in is a redirect the
# browser follows, not a fetch made here, so it needs the public address.
#
# Falls back to API_BASE_URL when unset, which is correct for local development
# where both are http://localhost:8080.
# PUBLIC_API_BASE_URL=http://localhost:8080
